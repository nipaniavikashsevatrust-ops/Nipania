# ==============================================================================
# NIPANIA VIKASH SEVA TRUST - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your values for local or production use.

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL for Vercel / Neon / Supabase)
# ------------------------------------------------------------------------------
# Example for Vercel Postgres / Neon Serverless:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.postgres.vercel-storage.com/nipaniatrust?sslmode=require"

# Direct URL (for Prisma migrations if using PgBouncer / Connection Pooler)
# DIRECT_URL="postgresql://user:password@ep-sample.us-east-1.postgres.vercel-storage.com/nipaniatrust?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random secret (e.g. openssl rand -base64 32)
JWT_SECRET="replace-with-a-very-strong-and-secure-random-secret-key-32-chars-minimum"

# ------------------------------------------------------------------------------
# 3. Application Domain & Branding
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://nipaniatrust.org"
NEXT_PUBLIC_TRUST_NAME="NIPANIA VIKASH SEVA TRUST"
NEXT_PUBLIC_TRUST_PAN="AAFTN4004N"
NEXT_PUBLIC_TRUST_TAGLINE="SEVA | VIKASH | SAMARPAN"

# ------------------------------------------------------------------------------
# 4. Razorpay Payment Gateway (Optional - for online donations)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ------------------------------------------------------------------------------
# 5. Email & SMTP (Optional - for password resets & donation receipts)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="info@nipaniatrust.org"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Nipania Vikash Seva Trust <info@nipaniatrust.org>"
